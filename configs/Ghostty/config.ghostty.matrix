# Matrix — green phosphor terminal
# Inspired by the monochrome computer terminals in The Matrix.

background = #050a06
foreground = #cceecc

cursor-color = #00bb00
cursor-text = #050a06

selection-background = #174d26
selection-foreground = #ffffff

# ANSI colors — green phosphor, with enough contrast to remain practical.
# Normal
palette = 0=#050a06
palette = 1=#b83a45
palette = 2=#00bb00
palette = 3=#a8a83a
palette = 4=#3f7f4a
palette = 5=#6f4f7f
palette = 6=#4f9f72
palette = 7=#cceecc

# Bright
palette = 8=#3b5c40
palette = 9=#ff6670
palette = 10=#5ffa68
palette = 11=#dffddb
palette = 12=#72c77d
palette = 13=#a878b0
palette = 14=#76d99d
palette = 15=#ffffff

copy-on-select = clipboard
focus-follows-mouse = true
font-thicken = true
# font-feature = -liga
macos-non-native-fullscreen = true
mouse-hide-while-typing = true

# scrollback-limit in bytes, roughly 125,000 lines
scrollback-limit = 10000000

shell-integration = zsh
shell-integration-features = no-cursor,ssh-terminfo,ssh-env
# note: see zsh/.zshrc "ghostty integration"

### Keybindings
# super==cmd, alt==opt
# move between tabs is cmd+alt+arrow
keybind = super+alt+left=previous_tab
keybind = super+alt+right=next_tab
# move between panes is cmd+arrow
keybind = super+left=goto_split:previous
keybind = super+right=goto_split:next
# cmd+s sends :w<enter> - so cmd-s works in vim in terminal
keybind = super+s=text:\x1b:w\n

### Misc settings
desktop-notifications = false
quit-after-last-window-closed = true
window-new-tab-position = end
window-save-state = never

# window-colorspace = srgb
window-colorspace = display-p3
keybind = shift+enter=text:\n
